# ==========================================================================
# PRINTER BRIDGE — roda num PC da loja, na mesma rede das impressoras
# ==========================================================================

# simulate = NÃO toca nas impressoras; grava os cupons em ./impressoes-simuladas
# live     = imprime de verdade
PRINT_MODE=simulate

# Supabase (Project Settings -> API). A service_role fica SÓ neste PC.
SUPABASE_URL=https://byamgmjeqawznkagouwd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# IP das impressoras Epson (porta 9100 é o padrão RAW/ESC-POS)
# Use os mesmos IPs já configurados no sistema atual da loja.
PRINTER_GRILL=192.168.0.0:9100
PRINTER_KITCHEN=192.168.0.0:9100
# Opcionais: se vazios, BAR vai para a cozinha e o cupom de expedição do delivery também
PRINTER_BAR=
PRINTER_CASHIER=

# 48 colunas = papel 80mm (fonte A) | 32 colunas = papel 58mm
PAPER_COLUMNS=48
RESTAURANT_NAME=ESPETARIA SABOR DA CARNE
# Bip ao imprimir pedido (só modelos com buzzer)
BEEP_ON_ORDER=false

PRINT_TIMEOUT_MS=5000
POLL_INTERVAL_MS=4000
OUTPUT_DIR=./impressoes-simuladas
WORKER_NAME=
PORT=4021

# Cupom de expedição separado no delivery (cliente/endereço já saem no cupom de cada setor)
PRINT_DELIVERY_SUMMARY=false

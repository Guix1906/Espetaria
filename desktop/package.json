{
  "name": "ponto-desktop",
  "productName": "Ponto",
  "version": "1.0.3",
  "description": "Ponto para o PC da loja: sistema e WhatsApp Web na mesma janela",
  "author": "Espetaria Sabor da Carne",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tech.pontopdv.desktop",
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "pt-BR"
    ],
    "win": {
      "artifactName": "Ponto.${ext}",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "runAfterFinish": true
    }
  }
}

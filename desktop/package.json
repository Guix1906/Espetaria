{
  "name": "ponto-desktop",
  "productName": "Ponto",
  "version": "1.0.0",
  "description": "Ponto para o PC da loja: sistema e WhatsApp Web na mesma janela",
  "author": "Espetaria Sabor da Carne",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tech.pontopdv.desktop",
    "files": ["main.js", "preload.js"],
    "directories": { "output": "dist" },
    "win": { "artifactName": "Ponto.${ext}", "signAndEditExecutable": false }
  }
}

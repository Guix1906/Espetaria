# ==========================================
# ESPETARIA SABOR DA CARNE — CONFIGURAÇÃO DO AMBIENTE
# ==========================================
# ATENÇÃO: NUNCA insira sua SERVICE_ROLE_KEY ou tokens de WhatsApp neste arquivo
# do frontend Vite. Elas devem residir apenas em Supabase Edge Functions seguras.

# URL do seu projeto Supabase (Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co

# Chave pública anônima do Supabase (Anon/Public key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Timezone padrão do estabelecimento
VITE_DEFAULT_TIMEZONE=America/Sao_Paulo

# Nome do estabelecimento para exibição em comprovantes e PWA
VITE_RESTAURANT_NAME="Espetaria Sabor da Carne"
